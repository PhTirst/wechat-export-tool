+//go:build windows
+
+package keycapture
+
+// Synthetic SID comparisons and the test process's own token only.
+// 仅使用合成 SID 及测试进程自身令牌，不枚举微信、账号或进程内存。
+// Upstream WxMori retains its MIT copyright and license; see LICENSE.
+
+import (
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestSameOwnerSIDRequiresNonNilEqualNativeSID(t *testing.T) {
+	first, err := windows.StringToSid("S-1-5-21-11-22-33-1001")
+	if err != nil {
+		t.Fatal("synthetic SID construction failed")
+	}
+	copy, err := windows.StringToSid("S-1-5-21-11-22-33-1001")
+	if err != nil {
+		t.Fatal("synthetic SID construction failed")
+	}
+	other, err := windows.StringToSid("S-1-5-21-11-22-33-1002")
+	if err != nil {
+		t.Fatal("synthetic SID construction failed")
+	}
+	if !sameOwnerSID(first, copy) || sameOwnerSID(first, other) || sameOwnerSID(nil, first) || sameOwnerSID(first, nil) || sameOwnerSID(nil, nil) {
+		t.Fatal("native owner comparison did not fail closed")
+	}
+}
+
+func TestOwnTestProcessTokenMatchesAndUnknownHandleFailsClosed(t *testing.T) {
+	current, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil || current.User.Sid == nil {
+		t.Fatal("test-process token unavailable")
+	}
+	owned, err := processHasUserSID(windows.CurrentProcess(), current.User.Sid)
+	if err != nil || !owned {
+		t.Fatal("test process did not match its own token")
+	}
+	if owned, err := processHasUserSID(0, current.User.Sid); err == nil || owned {
+		t.Fatal("unknown process token was accepted")
+	}
+	if owned, err := processHasUserSID(windows.CurrentProcess(), nil); err == nil || owned {
+		t.Fatal("unknown expected owner was accepted")
+	}
+	nullOwner, err := windows.StringToSid("S-1-0-0")
+	if err != nil {
+		t.Fatal("synthetic SID construction failed")
+	}
+	if owned, err := processHasUserSID(windows.CurrentProcess(), nullOwner); err != nil || owned {
+		t.Fatal("unrelated synthetic owner was accepted")
+	}
+}
