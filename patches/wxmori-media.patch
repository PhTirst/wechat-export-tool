+package keycapture
+
+// Synthetic tests for the selected-account adaptation of upstream WxMori.
+// 上游 WxMori 的 MIT 许可与版权声明保持不变，见仓库 LICENSE。
+
+import (
+	"testing"
+	"time"
+
+	"github.com/axiomzero-qed/WxMori/internal/config"
+)
+
+func TestStrictAccountSkipsAlternativeDiscoveryAndClearsPriorState(t *testing.T) {
+	t.Setenv("WXMORI_STRICT_ACCOUNT_ONLY", "1")
+	previous := mismatchAccounts
+	defer func() { mismatchAccounts = previous }()
+	enumerations := 0
+	mismatchAccounts = func(_, _, _ string) []config.Account {
+		enumerations++
+		return nil
+	}
+	remembered := NewProbe(nil)
+	var salt [16]byte
+	var key [32]byte
+	salt[0], key[0] = 17, 29
+	remembered.Keys[salt] = key
+	probe := mismatchProbe{
+		alternatives: []alternative{{probe: remembered}},
+		since:        time.Now(),
+	}
+	// Deliberately non-existent synthetic strings; the enumerator is replaced
+	// and strict mode must return without consulting any filesystem or process.
+	// 完全合成的路径与替代枚举器；严格模式不得触及真实文件或进程。
+	probe.reload(config.Config{DataDir: "synthetic-only/db_storage", Path: "synthetic-only/config.json"})
+	if enumerations != 0 {
+		t.Fatal("strict mode enumerated alternative accounts")
+	}
+	if len(probe.alternatives) != 0 || len(remembered.Keys) != 0 || !probe.since.IsZero() {
+		t.Fatal("strict mode retained alternative-account diagnostics")
+	}
+}
+
+func TestNonStrictDiscoveryUsesOnlySyntheticEnumerator(t *testing.T) {
+	t.Setenv("WXMORI_STRICT_ACCOUNT_ONLY", "0")
+	previous := mismatchAccounts
+	defer func() { mismatchAccounts = previous }()
+	enumerations := 0
+	mismatchAccounts = func(_, _, _ string) []config.Account {
+		enumerations++
+		return nil
+	}
+	probe := mismatchProbe{}
+	probe.reload(config.Config{DataDir: "synthetic-only/db_storage", Path: "synthetic-only/config.json"})
+	if enumerations != 1 {
+		t.Fatal("non-strict mode did not use the synthetic upstream discovery hook")
+	}
+}
