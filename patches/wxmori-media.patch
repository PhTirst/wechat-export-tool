@@ -0,0 +1,33 @@
+package keycapture
+
+import "testing"
+
+func TestCapturePIDIsOptInAndStrictPositiveUint32(t *testing.T) {
+	for _, value := range []string{"0", "-1", "+1", "12.0", "1x", "4294967296"} {
+		t.Setenv("WXMORI_CAPTURE_PID", value)
+		if _, err := capturePIDFromEnvironment(); err == nil {
+			t.Fatal("invalid capture PID was accepted")
+		}
+	}
+	t.Setenv("WXMORI_CAPTURE_PID", "12345")
+	if selected, err := capturePIDFromEnvironment(); err != nil || selected != 12345 {
+		t.Fatal("explicit positive capture PID was not selected")
+	}
+	t.Setenv("WXMORI_CAPTURE_PID", "")
+	if selected, err := capturePIDFromEnvironment(); err != nil || selected != 0 {
+		t.Fatal("unset capture PID changed default enumeration")
+	}
+}
+
+func TestCapturePIDRestrictsOnlyPreviouslyEnumeratedSyntheticProcesses(t *testing.T) {
+	first, second := &process{pid: 1001}, &process{pid: 1002}
+	if selected := restrictCaptureProcesses([]*process{first, second}, 1002); len(selected) != 1 || selected[0] != second {
+		t.Fatal("explicit PID did not isolate the enumerated synthetic process")
+	}
+	if selected := restrictCaptureProcesses([]*process{first, second}, 9999); len(selected) != 0 {
+		t.Fatal("missing explicit PID fell back to another process")
+	}
+	if selected := restrictCaptureProcesses([]*process{first, second}, 0); len(selected) != 2 {
+		t.Fatal("default enumeration was restricted")
+	}
+}
