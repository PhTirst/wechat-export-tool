@@ -0,0 +1,58 @@
+//go:build windows
+
+package keycapture
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/axiomzero-qed/WxMori/internal/config"
+	"github.com/axiomzero-qed/WxMori/internal/keyring"
+)
+
+func TestCachedDatabasesStillEnterWatcherForRequestedImage(t *testing.T) {
+	dir := t.TempDir()
+	target, key := fixtureTarget()
+	for _, name := range []string{"contact.db", "message_0.db"} {
+		if err := os.WriteFile(filepath.Join(dir, name), target.Page, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	configuration := config.Config{DataDir: dir, Path: filepath.Join(t.TempDir(), "config.json")}
+	if err := keyring.SaveCaptured(configuration.CapturedKeyFile(), keyring.AccountID(dir), map[[16]byte][32]byte{target.Salt: key}); err != nil {
+		t.Fatal(err)
+	}
+	var imageKey [16]byte
+	header, ciphertext, _ := syntheticImageSample(t, imageKey, append([]byte("\x89PNG\r\n\x1a\n"), make([]byte, 32)...))
+	probe, _ := json.Marshal(map[string]any{"version": 1, "samples": []map[string]string{{"header_hex": header, "ciphertext_base64": ciphertext}}})
+	probePath := filepath.Join(t.TempDir(), "probe.json")
+	if err := os.WriteFile(probePath, probe, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("WXMORI_IMAGE_PROBE", probePath)
+	t.Setenv("WXMORI_IMAGE_KEY_FILE", filepath.Join(t.TempDir(), "image.json"))
+	manager := New(configuration)
+	defer manager.Close()
+	var enumerations atomic.Int32
+	// Synthetic empty enumeration must never inspect any real user's process.
+	manager.enumerate = func() ([]*process, int, error) {
+		enumerations.Add(1)
+		return nil, 0, nil
+	}
+	status, err := manager.Start(time.Second)
+	if err != nil || !status.ImageProbeEnabled {
+		t.Fatal("explicit image opt-in was not present at startup")
+	}
+	deadline := time.Now().Add(4 * time.Second)
+	for manager.Status().Running && time.Now().Before(deadline) {
+		time.Sleep(20 * time.Millisecond)
+	}
+	status = manager.Status()
+	if status.Running || status.State == "completed" || status.ImageKeyCaptured || status.VerifiedDatabases != 2 || enumerations.Load() == 0 {
+		t.Fatal("cached complete databases incorrectly skipped the outstanding image watcher")
+	}
+}
diff --git a/internal/keycapture/image_probe.go b/internal/keycapture/image_probe.go
new file mode 100644
index 0000000..6ba0b74
--- /dev/null
+++ b/internal/keycapture/image_probe.go
@@ -0,0 +1,175 @@
+package keycapture
+
+import (
+	"bytes"
+	"crypto/aes"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+
+	"github.com/axiomzero-qed/WxMori/internal/keyring"
+)
+
+const maxImageProbeBytes = 16 << 20
+
+type imageProbeSample struct {
+	plainLength int
+	ciphertext  []byte
+}
+
+type imageProbe struct {
+	samples  []imageProbeSample
+	output   string
+	seen     map[[16]byte]bool
+	captured bool
+}
+
+// The explicit probe contains only a 15-byte V2 container header and the entire
+// padded AES ciphertext section. It contains neither a key nor an image path.
+type imageProbeJSON struct {
+	Version int `json:"version"`
+	Samples []struct {
+		HeaderHex        string `json:"header_hex"`
+		CiphertextBase64 string `json:"ciphertext_base64"`
+	} `json:"samples"`
+}
+
+func decodeImageProbe(reader io.Reader, output string) (*imageProbe, error) {
+	data, err := io.ReadAll(io.LimitReader(reader, maxImageProbeBytes+1))
+	if err != nil || len(data) > maxImageProbeBytes {
+		return nil, errors.New("invalid image probe size")
+	}
+	defer clear(data)
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var document imageProbeJSON
+	if decoder.Decode(&document) != nil || decoder.Decode(new(any)) != io.EOF || document.Version != 1 || len(document.Samples) == 0 || len(document.Samples) > 8 {
+		return nil, errors.New("invalid image probe format")
+	}
+	probe := &imageProbe{output: output, seen: map[[16]byte]bool{}}
+	total := 0
+	for _, sample := range document.Samples {
+		header, e := hex.DecodeString(sample.HeaderHex)
+		if e != nil || len(header) != 15 || !bytes.Equal(header[:6], []byte{7, 8, 'V', '2', 8, 7}) {
+			probe.clear()
+			return nil, errors.New("invalid image probe header")
+		}
+		length := int(binary.LittleEndian.Uint32(header[6:10]))
+		ciphertext, e := base64.StdEncoding.DecodeString(sample.CiphertextBase64)
+		if e != nil || length < 1 || length > 2<<20 || len(ciphertext) != length+(aes.BlockSize-length%aes.BlockSize) {
+			clear(ciphertext)
+			probe.clear()
+			return nil, errors.New("invalid image probe ciphertext")
+		}
+		total += len(ciphertext)
+		if total > 8<<20 {
+			clear(ciphertext)
+			probe.clear()
+			return nil, errors.New("image probe budget exceeded")
+		}
+		probe.samples = append(probe.samples, imageProbeSample{length, ciphertext})
+	}
+	return probe, nil
+}
+
+func imageProbeFromEnvironment() (*imageProbe, error) {
+	path, output := os.Getenv("WXMORI_IMAGE_PROBE"), os.Getenv("WXMORI_IMAGE_KEY_FILE")
+	if path == "" && output == "" {
+		return nil, nil
+	}
+	if path == "" || output == "" {
+		return nil, errors.New("both image probe environment variables are required")
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, errors.New("image probe could not be read")
+	}
+	defer file.Close()
+	return decodeImageProbe(file, output)
+}
+
+func imageProbeConfigured() bool {
+	return os.Getenv("WXMORI_IMAGE_PROBE") != "" || os.Getenv("WXMORI_IMAGE_KEY_FILE") != ""
+}
+
+func captureGoalsComplete(databaseComplete, imageEnabled, imageCaptured bool) bool {
+	return databaseComplete && (!imageEnabled || imageCaptured)
+}
+
+func (m *Manager) goalsComplete(databaseComplete bool) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return captureGoalsComplete(databaseComplete, m.status.ImageProbeEnabled, m.status.ImageKeyCaptured)
+}
+
+func (p *imageProbe) clear() {
+	for i := range p.samples {
+		clear(p.samples[i].ciphertext)
+	}
+	p.samples = nil
+	clear(p.seen)
+}
+
+func imageHeader(plain []byte) bool {
+	if len(plain) < 16 {
+		return false
+	}
+	jpeg := plain[0] == 0xff && plain[1] == 0xd8 && plain[2] == 0xff && plain[3] >= 0xc0 && plain[3] != 0xff && plain[3] != 0xd8 && plain[3] != 0xd9
+	return jpeg || bytes.HasPrefix(plain, []byte("\x89PNG\r\n\x1a\n")) || bytes.HasPrefix(plain, []byte("GIF87a")) || bytes.HasPrefix(plain, []byte("GIF89a")) || (bytes.Equal(plain[:4], []byte("RIFF")) && bytes.Equal(plain[8:12], []byte("WEBP"))) || bytes.HasPrefix(plain, []byte("wxgf"))
+}
+
+// verifiesImageKey validates header, every encrypted block, the whole PKCS7
+// padding, and the exact unpadded length from the supplied V2 header. V2 has no
+// authentication tag; callers must still confirm the complete decoded image.
+func (p *imageProbe) verifiesImageKey(key [16]byte) bool {
+	block, err := aes.NewCipher(key[:])
+	if err != nil {
+		return false
+	}
+	for _, sample := range p.samples {
+		var first [aes.BlockSize]byte
+		block.Decrypt(first[:], sample.ciphertext[:aes.BlockSize])
+		matches := imageHeader(first[:])
+		clear(first[:])
+		if !matches {
+			continue
+		}
+		plain := make([]byte, len(sample.ciphertext))
+		for offset := 0; offset < len(plain); offset += aes.BlockSize {
+			block.Decrypt(plain[offset:offset+aes.BlockSize], sample.ciphertext[offset:offset+aes.BlockSize])
+		}
+		padding := int(plain[len(plain)-1])
+		valid := padding >= 1 && padding <= aes.BlockSize && len(plain)-padding == sample.plainLength
+		if valid {
+			for _, value := range plain[len(plain)-padding:] {
+				if int(value) != padding {
+					valid = false
+				}
+			}
+		}
+		clear(plain)
+		if valid {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *imageProbe) observe(key [16]byte) (bool, error) {
+	if p.captured || p.seen[key] || len(p.seen) >= 8192 {
+		return false, nil
+	}
+	p.seen[key] = true
+	if !p.verifiesImageKey(key) {
+		return false, nil
+	}
+	if err := keyring.SaveImageCandidate(p.output, key); err != nil {
+		return false, errors.New("image candidate could not be protected")
+	}
+	p.captured = true
+	return true, nil
+}
diff --git a/internal/keycapture/image_probe_test.go b/internal/keycapture/image_probe_test.go
new file mode 100644
index 0000000..73236aa
--- /dev/null
+++ b/internal/keycapture/image_probe_test.go
@@ -0,0 +1,111 @@
+package keycapture
+
+import (
+	"bytes"
+	"crypto/aes"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"testing"
+)
+
+func syntheticImageSample(t *testing.T, key [16]byte, plaintext []byte) (string, string, []byte) {
+	t.Helper()
+	header := make([]byte, 15)
+	copy(header, []byte{7, 8, 'V', '2', 8, 7})
+	binary.LittleEndian.PutUint32(header[6:], uint32(len(plaintext)))
+	padding := aes.BlockSize - len(plaintext)%aes.BlockSize
+	padded := append(append([]byte(nil), plaintext...), bytes.Repeat([]byte{byte(padding)}, padding)...)
+	block, err := aes.NewCipher(key[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	ciphertext := make([]byte, len(padded))
+	for i := 0; i < len(padded); i += aes.BlockSize {
+		block.Encrypt(ciphertext[i:i+aes.BlockSize], padded[i:i+aes.BlockSize])
+	}
+	return hex.EncodeToString(header), base64.StdEncoding.EncodeToString(ciphertext), ciphertext
+}
+
+func TestImageProbeValidatesFullSectionAndPadding(t *testing.T) {
+	var key [16]byte
+	for i := range key {
+		key[i] = byte(i + 41)
+	}
+	for _, prefix := range [][]byte{
+		{0xff, 0xd8, 0xff, 0xe0}, []byte("\x89PNG\r\n\x1a\n"), []byte("GIF87a"), []byte("GIF89a"), []byte("RIFF0000WEBP"), []byte("wxgf"),
+	} {
+		plain := append(append([]byte(nil), prefix...), bytes.Repeat([]byte{0x5a}, 64)...)
+		header, ciphertext, _ := syntheticImageSample(t, key, plain)
+		document := imageProbeJSON{Version: 1}
+		document.Samples = append(document.Samples, struct {
+			HeaderHex        string `json:"header_hex"`
+			CiphertextBase64 string `json:"ciphertext_base64"`
+		}{header, ciphertext})
+		encoded, _ := json.Marshal(document)
+		probe, err := decodeImageProbe(bytes.NewReader(encoded), "not-used")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !probe.verifiesImageKey(key) {
+			t.Fatal("valid synthetic format was rejected")
+		}
+		wrong := key
+		wrong[0] ^= 1
+		if probe.verifiesImageKey(wrong) {
+			t.Fatal("wrong key was accepted")
+		}
+		// Keep the valid first block while deterministically invalidating only
+		// the final block's PKCS7 padding. Prefix-only acceptance must fail.
+		block, _ := aes.NewCipher(key[:])
+		last := make([]byte, aes.BlockSize)
+		last[len(last)-1] = 0
+		at := len(probe.samples[0].ciphertext) - aes.BlockSize
+		block.Encrypt(probe.samples[0].ciphertext[at:], last)
+		if probe.verifiesImageKey(key) {
+			t.Fatal("invalid full-section padding was accepted")
+		}
+		probe.clear()
+	}
+}
+
+func TestImageProbeRejectsMalformedOrUnrelatedCiphertext(t *testing.T) {
+	for _, input := range []string{
+		`{}`, `{"version":1,"samples":[]}`, `{"version":2,"samples":[{}]}`,
+		`{"version":1,"samples":[{"header_hex":"00","ciphertext_base64":"AA=="}]}`,
+		`{"version":1,"samples":[{}],"unexpected":true}`,
+	} {
+		if probe, err := decodeImageProbe(bytes.NewBufferString(input), "unused"); err == nil {
+			probe.clear()
+			t.Fatal("malformed synthetic probe accepted")
+		}
+	}
+	var key [16]byte
+	_, _, encrypted := syntheticImageSample(t, key, bytes.Repeat([]byte{'x'}, 32))
+	probe := &imageProbe{samples: []imageProbeSample{{32, encrypted}}}
+	if probe.verifiesImageKey(key) {
+		t.Fatal("valid padding without an image header was accepted")
+	}
+}
+
+func TestCaptureCompletionRequiresRequestedImage(t *testing.T) {
+	for _, databasesComplete := range []bool{false, true} {
+		for _, enabled := range []bool{false, true} {
+			for _, captured := range []bool{false, true} {
+				expected := databasesComplete && (!enabled || captured)
+				if got := captureGoalsComplete(databasesComplete, enabled, captured); got != expected {
+					t.Fatal("capture completed with an outstanding requested goal")
+				}
+			}
+		}
+	}
+	manager := &Manager{status: Status{ImageProbeEnabled: true}}
+	if manager.goalsComplete(true) {
+		t.Fatal("cached database keys bypassed requested image capture")
+	}
+	manager.status.ImageKeyCaptured = true
+	if !manager.goalsComplete(true) {
+		t.Fatal("verified image and complete databases did not complete")
+	}
+}
