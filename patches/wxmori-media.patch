@@ -0,0 +1,101 @@
+//go:build windows
+
+package keyring
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+
+	"golang.org/x/sys/windows"
+)
+
+func privateImageACL(path string, directory bool) error {
+	user, err := windows.GetCurrentProcessToken().GetTokenUser()
+	if err != nil {
+		return err
+	}
+	inherit := ""
+	if directory {
+		inherit = "OICI"
+	}
+	sid := user.User.Sid.String()
+	aces := "(A;" + inherit + ";FA;;;" + sid + ")"
+	if sid != "S-1-5-18" {
+		aces += "(A;" + inherit + ";FA;;;SY)"
+	}
+	sd, err := windows.SecurityDescriptorFromString("O:" + sid + "D:P" + aces)
+	if err != nil {
+		return err
+	}
+	dacl, _, err := sd.DACL()
+	if err != nil {
+		return err
+	}
+	return windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT,
+		windows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION,
+		nil, nil, dacl, nil)
+}
+
+// SaveImageCandidate never shares the database-key schema: the plaintext is
+// {aes: 16-byte hex, xor: null}, protected by DPAPI without optional entropy.
+func SaveImageCandidate(path string, key [16]byte) error {
+	defer clear(key[:])
+	if path == "" {
+		return errors.New("image candidate output is required")
+	}
+	parent := filepath.Dir(path)
+	if err := os.MkdirAll(parent, 0700); err != nil {
+		return errors.New("image candidate directory unavailable")
+	}
+	if info, err := os.Lstat(parent); err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.New("image candidate parent must be a directory")
+	}
+	if err := privateImageACL(parent, true); err != nil {
+		return errors.New("image candidate directory ACL failed")
+	}
+	plain, err := json.Marshal(struct {
+		AES string `json:"aes"`
+		XOR *int   `json:"xor"`
+	}{hex.EncodeToString(key[:]), nil})
+	if err != nil {
+		return errors.New("image candidate encoding failed")
+	}
+	defer clear(plain)
+	sealed, err := protect(plain)
+	if err != nil {
+		return errors.New("image candidate DPAPI failed")
+	}
+	data, err := json.Marshal(Envelope{Format: "local-image.dpapi.v1", Protected: sealed})
+	if err != nil {
+		return errors.New("image candidate envelope failed")
+	}
+	tmp, err := os.CreateTemp(parent, ".image-candidate-")
+	if err != nil {
+		return errors.New("image candidate staging failed")
+	}
+	name := tmp.Name()
+	defer os.Remove(name)
+	if err = privateImageACL(name, false); err == nil {
+		_, err = tmp.Write(append(data, '\n'))
+	}
+	if err == nil {
+		err = tmp.Sync()
+	}
+	closeErr := tmp.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = os.Rename(name, path)
+	}
+	if err != nil {
+		return errors.New("image candidate publishing failed")
+	}
+	if err := privateImageACL(path, false); err != nil {
+		return errors.New("image candidate ACL failed")
+	}
+	return nil
+}
