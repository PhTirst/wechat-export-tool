+//go:build windows
+
+package keyring
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestImageCandidateDPAPIRoundTrip(t *testing.T) {
+	var key [16]byte
+	for i := range key {
+		key[i] = byte(i + 61)
+	}
+	path := filepath.Join(t.TempDir(), "candidate.json")
+	for i := 0; i < 2; i++ {
+		if err := SaveImageCandidate(path, key); err != nil {
+			t.Fatal(err)
+		}
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(data, []byte(hex.EncodeToString(key[:]))) {
+		t.Fatal("plaintext image key was saved")
+	}
+	var envelope Envelope
+	if err := json.Unmarshal(data, &envelope); err != nil || envelope.Format != "local-image.dpapi.v1" {
+		t.Fatal("incompatible image envelope")
+	}
+	plain, err := unprotect(envelope.Protected)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer clear(plain)
+	var decoded struct {
+		AES string `json:"aes"`
+		XOR *int   `json:"xor"`
+	}
+	if err := json.Unmarshal(plain, &decoded); err != nil || decoded.AES != hex.EncodeToString(key[:]) || decoded.XOR != nil {
+		t.Fatal("incompatible protected image payload")
+	}
+}
