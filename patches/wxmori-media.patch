+	text := strings.TrimSpace(os.Getenv("WXMORI_CAPTURE_PID"))
+	if text == "" {
+		return 0, nil
+	}
+	for _, digit := range text {
+		if digit < '0' || digit > '9' {
+			return 0, errors.New("capture PID must be positive decimal")
+		}
+	}
+	value, err := strconv.ParseUint(text, 10, 32)
